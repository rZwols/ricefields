{
    // "layer": "top", // Waybar at top layer
    "position": "left", // Waybar position (top|bottom|left|right)
    //"height": 10, // Waybar height (to be removed for auto height)
    "width": 30, // Waybar width
    "spacing": 4, // Gaps between modules
    "margin": "5px",
    "markup": true,
    // Choose the order of the modules
    "modules-left": [
        "custom/notification",
        "clock",
    ],
    "modules-center": [
        "hyprland/workspaces",
    ],
    "modules-right": [
        "wireplumber",
        "battery",
        "custom/power",
    ],

    "custom/notification": {
        "format": "",
        "on-click": "swaync-client -t -sw",
    },

    "clock": {
        "format": " 󰥔 \n{:%I\n%M\n%p}",
        "format-alt": " 󰥔 \n{:%H\n%M}",
        "interval": 1,
        "justify": "center",
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
    },

    "wireplumber": {
        "format": " \n{volume}",
        "format-muted": " \n0",    
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "justify": "center",
    },

    "battery": {
	    "interval": 5,
        "states": {
            "good": 60,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon}\n{capacity}",
        "format-charging": "\n{capacity}",
        "format-plugged": "\n{capacity}",
        "format-alt": "{time}",
        "format-icons": ["  ", "  ", "  ", "  ", "  "],

        "justify": "center",
    },

    "custom/power": {
        "format": "",
        "tooltip": "Shut down",
        "on-click": "systemctl poweroff"
    },
}
